# --- Runtime ---
# One of: development | test | staging | production
ENVIRONMENT=development
PORT=4000

# --- Observability (see @healthstack/logger) ---
SERVICE_NAME=healthstack-api
# Optional build identifier, emitted as `version` on every log/audit record.
APP_VERSION=
# Optional override of the per-environment default log level:
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=
# Optional physical site identifier, emitted on audit records.
SITE_ID=

# --- Dependencies ---
DATABASE_URL=
JWT_SECRET=
CORS_URL=http://localhost:3000
